{
  "name": "basis",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "npm run prisma:generate",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma && prisma generate --schema prisma/schema.sqlite.prisma",
    "db:migrate:sqlite-to-postgres": "tsx scripts/migrate-sqlite-to-postgres.ts",
    "db:migrate:sqlite": "prisma migrate dev --config prisma.sqlite.config.ts",
    "dev": "next dev",
    "mcp": "tsx mcp/server.ts",
    "mcp:eval": "tsx mcp/evaluate.ts",
    "mcp:token": "node -e \"console.log('BASIS_MCP_BEARER_TOKEN=\\\"' + require('node:crypto').randomBytes(32).toString('hex') + '\\\"')\"",
    "test:mcp-auth": "tsx scripts/evaluate-mcp-auth.ts",
    "auth:invite": "tsx scripts/create-auth-invite.ts",
    "test:income": "tsx scripts/evaluate-income-projection.ts",
    "test:physician": "tsx scripts/evaluate-physician-planning.ts",
    "test:expenses": "tsx scripts/evaluate-expense-categorization.ts",
    "test:tenant": "tsx scripts/evaluate-tenant-isolation.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.0",
    "@better-auth/prisma-adapter": "^1.7.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@stytch/nextjs": "^22.2.0",
    "better-auth": "^1.7.1",
    "better-sqlite3": "^12.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "jose": "^6.2.10",
    "lucide-react": "^1.23.0",
    "next": "^16.3.3",
    "pg": "^8.23.0",
    "plaid": "^46.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-plaid-link": "^5.0.0",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "stytch": "^14.2.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.3",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
