# Production uses Neon's pooled runtime connection. Vercel's Neon integration
# injects both values automatically.
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/database?sslmode=verify-full"
DATABASE_URL_UNPOOLED="postgresql://user:password@host.neon.tech/database?sslmode=verify-full"
# For local-only development, DATABASE_URL may instead be file:./prisma/dev.db.
# Used only by the one-shot migration command.
SQLITE_DATABASE_URL="file:./prisma/dev.db"

# Authentication. Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Comma-separated exact emails allowed to access /admin routes.
BASIS_ADMIN_EMAILS=""

# Google Cloud OAuth 2.0 Web application credentials.
# Local callback: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Public iOS OAuth client ID for the Capacitor Google sign-in flow.
GOOGLE_IOS_CLIENT_ID=""
# Password auth is enabled automatically in development. Keep this false in
# production until verified-email delivery and password reset are configured.
ENABLE_PASSWORD_AUTH="false"

# Create a key at https://vercel.com/ai-gateway or use Vercel OIDC in production.
AI_GATEWAY_API_KEY=""
# Any Vercel AI Gateway provider/model identifier.
AI_GATEWAY_MODEL="anthropic/claude-sonnet-4.6"
# Set true in production only after enabling Zero Data Retention in Vercel.
AI_GATEWAY_ZDR_CONFIRMED="false"

# Personal Coinbase integration. Create an ECDSA key with View permission only.
# Keep the PEM on one line with escaped newlines when needed.
COINBASE_API_KEY_NAME=""
COINBASE_API_PRIVATE_KEY=""
# The only financial profile allowed to use the server-level personal key.
COINBASE_LEGACY_USER_ID=""

# Plaid trial credentials from https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=""
PLAID_SECRET=""
# Use "production" for real institutions on Plaid Trial or paid plans.
# Use "sandbox" with Plaid's test credentials and institutions.
PLAID_ENV="production"
# Only this migrated owner profile may use server-level Plaid credentials.
# Every other profile must add its own credentials in the Accounts UI.
PLAID_LEGACY_USER_ID=""

# Generate with: openssl rand -hex 32
PLAID_TOKEN_ENCRYPTION_KEY=""

# Optional for OAuth institutions and deployed webhook delivery.
PLAID_REDIRECT_URI=""
PLAID_WEBHOOK_URL=""

# Local, read-only MCP server. The server intentionally refuses non-loopback hosts.
BASIS_MCP_HOST="127.0.0.1"
BASIS_MCP_PORT="3001"
# Required. Generate with: npm run mcp:token
BASIS_MCP_BEARER_TOKEN=""
# Required only if the database contains more than one user.
BASIS_MCP_USER_ID=""

# Deployed MCP OAuth (Stytch Consumer Connected Apps). Better Auth remains
# the app login; Stytch only issues revocable OAuth tokens to ChatGPT/Claude.
NEXT_PUBLIC_STYTCH_PUBLIC_TOKEN=""
# Copy the default domain from Stytch Project settings, e.g.
# https://noun-verb-1234.customers.stytch.com
NEXT_PUBLIC_STYTCH_PROJECT_DOMAIN=""
STYTCH_PROJECT_ID=""
STYTCH_SECRET=""
STYTCH_TRUSTED_AUTH_TOKEN_PROFILE_ID=""
